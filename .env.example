# Second Brain local development environment (Phase 0).
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# All values below are placeholders. Never commit real secrets.

# ---- Postgres (pgvector) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=secondbrain
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:changeme-postgres@localhost:5432/secondbrain

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=secondbrain
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000

# ---- JWT (placeholders only - rotate in production) ----
JWT_SECRET=changeme-jwt-signing-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- LLM / embeddings / reranker (placeholders only - no real LLM in Phase 0) ----
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=changeme-llm-key
LLM_MODEL=placeholder-llm
EMBEDDING_MODEL_KEY=placeholder-embedder
RERANKER_MODEL_KEY=placeholder-reranker
